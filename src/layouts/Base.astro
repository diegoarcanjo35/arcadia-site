---
import '../styles/marca.css';
import Cabecalho from '../components/Cabecalho.astro';
import Rodape from '../components/Rodape.astro';

const {
  titulo,
  descricao,
  imagem = '/og-padrao.png',
  tipo = 'website',
  cabecalhoSobreImagem = false,
} = Astro.props;

const url = new URL(Astro.url.pathname, Astro.site);
const tituloCompleto = titulo ? `${titulo} · Arcádia Psicologia` : 'Arcádia Psicologia';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={url} />

    {/* Open Graph — ausente no site anterior. Sem isso, colar o link no
        WhatsApp mostrava só a URL crua, sem imagem nem descrição. */}
    <meta property="og:type" content={tipo} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={new URL(imagem, Astro.site)} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="Arcádia Psicologia" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/simbolo.svg" type="image/svg+xml" />

    {/* Fontes servidas pelo próprio site — ver src/styles/marca.css.
        Nenhuma requisição a terceiros parte desta página. */}
    <link rel="preload" href="/fontes/cardo-latin-ext-700-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fontes/inter-latin-ext-400-normal.woff2" as="font" type="font/woff2" crossorigin />

    <slot name="head" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>
    <Cabecalho sobreImagem={cabecalhoSobreImagem} />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape />

    <style>
      .pular {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--terracota);
        color: #fff;
        padding: var(--e-1) var(--e-2);
        z-index: 100;
        text-decoration: none;
      }
      .pular:focus { left: 0; }
      main { min-height: 60vh; }
    </style>

    {/* Global, e não escopado: o botão aparece em páginas que só recebem o
        conteúdo via slot (a-arcadia, serviços, oficinas...), onde o CSS
        escopado de um componente-página não alcança. Morava só no index.astro
        antes, e por isso só funcionava lá — nas outras páginas o link "botão"
        renderizava sem nenhum estilo. */}
    {/* Medido direto no botão real do site anterior (getComputedStyle), não
        estimado: 14.4px, padding 9.6px/16px, radius 5.28px, texto creme
        (não branco puro), sem borda — o site anterior não tem contorno. */}
    <style is:global>
      .botao {
        display: inline-block;
        background: var(--terracota);
        color: var(--creme);
        text-decoration: none;
        padding: 0.6rem 1rem;
        border-radius: 0.33rem;
        font-size: 0.9rem;
        font-weight: 500;
        border: none;
      }
      .botao:hover { background: var(--terracota-escuro); color: var(--creme); }
      .botao.vazado { background: transparent; color: var(--terracota); border: 1.5px solid var(--terracota); }
      .botao.vazado:hover { background: var(--terracota); color: var(--creme); }
    </style>

    {/* Toda página interna abre com uma <section class="capa"> (duas <img>,
        uma por breakpoint — ver a-arcadia/servicos/contato/etc.). Numa rede
        lenta, ela pintava em duas etapas: a página (cabeçalho, título) e só
        depois, visivelmente por cima, a foto. Mesma filosofia do Revelar.astro:
        nada começa escondido no HTML — só o próprio script, já rodando, é que
        esconde a capa por um instante para revelar tudo junto quando a foto
        certa (mobile ou desktop, a que está de fato visível) terminar de
        carregar. Sem JS, ou com JS lento, a capa nunca fica escondida. */}
    <style is:global>
      html.js-capa .capa { opacity: 0; transition: opacity 400ms ease; }
      html.js-capa .capa.carregada { opacity: 1; }
      @media (prefers-reduced-motion: reduce) {
        html.js-capa .capa { transition: none; }
      }
    </style>
    <script>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('js-capa');

        document.querySelectorAll('section.capa').forEach((capa) => {
          const fotos = Array.from(capa.querySelectorAll('img.foto-capa')).filter(
            (img) => getComputedStyle(img).display !== 'none'
          );
          if (fotos.length === 0 || fotos.every((img) => img.complete && img.naturalWidth > 0)) {
            capa.classList.add('carregada');
            return;
          }
          let restantes = fotos.length;
          const contar = () => {
            if (--restantes <= 0) capa.classList.add('carregada');
          };
          fotos.forEach((img) => {
            img.addEventListener('load', contar, { once: true });
            img.addEventListener('error', contar, { once: true });
          });
          // Rede de segurança, mesmo prazo do Revelar.astro: se a foto nunca
          // carregar (rede ruim, arquivo quebrado), mostra do mesmo jeito.
          setTimeout(() => capa.classList.add('carregada'), 3000);
        });
      }
    </script>
  </body>
</html>
