---
/**
 * Faixa de fotografia entre seções, fixa enquanto o texto rola.
 *
 * Mesmo efeito da capa de página, em altura menor. É o que dá o ritmo às
 * páginas internas do site anterior: bloco de texto, faixa de foto, bloco de
 * texto. A foto não ilustra o parágrafo ao lado — ela serve de respiro entre
 * um assunto e outro.
 *
 * Decorativa por definição: `alt` vazio e `aria-hidden`. Descrever "sala de
 * atendimento" a cada respiro não ajuda quem usa leitor de tela, atrapalha.
 */
/**
 * `alturaMobile`: normalmente um número (percentual de altura de tela) — o
 * componente monta as duas variantes (vh e svh) sozinho, ver comentário no
 * media query abaixo sobre por que as duas existem. Também aceita uma string
 * com unidade própria (ex.: "730px"), para o caso em que o original usa uma
 * altura fixa igual no mobile e no desktop (min-height do wp-block-cover não
 * muda por breakpoint) — aí não faz sentido nenhuma das duas variantes vh.
 */
const { foto, altura = '42vh', alturaMobile = 30, class: classeExtra } = Astro.props;
const alturaMobileFixa = typeof alturaMobile !== 'number';
const alturaMobileVh = alturaMobileFixa ? alturaMobile : `${alturaMobile}vh`;
const alturaMobileSvh = alturaMobileFixa ? alturaMobile : `${alturaMobile}svh`;
---
{/* As variáveis de altura moram no wrapper, não na faixa em si: o wrapper
    também precisa delas (pro height do "corda extra" do sticky, ver
    comentário no <style>) e propriedade customizada só herda de fora pra
    dentro — definida só na faixa, o wrapper (que é PAI dela, não filho)
    não enxergava o valor. */}
<div
  class:list={['faixa-foto-caixa', classeExtra]}
  style={`--altura: ${altura}; --altura-mobile: ${alturaMobileVh}; --altura-mobile-svh: ${alturaMobileSvh}`}
>
  <div
    class:list={['faixa-foto', classeExtra]}
    style={`background-image: url(${foto})`}
    aria-hidden="true"
  ></div>
</div>

<style>
  .faixa-foto-caixa { position: relative; }
  .faixa-foto {
    min-height: var(--altura);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    background-color: var(--tinta);
  }

  @media (max-width: 900px) {
    /* svh, não só vh: no Safari mobile a barra de endereço recolhe ao
       rolar e vh muda de valor junto, fazendo a faixa "pular" de tamanho —
       svh usa a menor altura possível e fica estável. Vale pra qualquer
       navegador mobile, por isso fica fora do @supports abaixo: só a
       técnica de "segurar" a foto muda por engine, a altura em si não. */
    .faixa-foto {
      min-height: var(--altura-mobile);
      min-height: var(--altura-mobile-svh);
    }

    /* background-attachment:fixed continua igual ao site original em
       QUALQUER navegador — Chrome/Android incluído — exceto no motor da
       Apple: iOS tem anos de bugs conhecidos com fixed (foi o que causou a
       faixa "sobrepondo" as outras seções; nunca reproduzi em Chrome, só
       no Safari real). "iOS" aqui não é sinônimo de app Safari: todo
       navegador no iPhone (Chrome, Firefox, o que for) roda sobre o mesmo
       motor WebKit da Apple e herda o mesmo bug — por isso a detecção é
       por ENGINE, via -webkit-touch-callout (propriedade que só o WebKit
       do iOS reconhece, nem Android nem desktop), não por nome de app. Só
       nesse caso trocamos fixed por position:sticky, que não tem esse
       problema em navegador nenhum mas exige uma caixa por fora com mais
       altura que o conteúdo (testado ao vivo: precisa ser height de
       verdade no wrapper, padding-bottom fica sem efeito nenhum). O dobro
       da altura dá uma janela "grudada" do tamanho da própria foto —
       perto do tempo que o fixed original fica com essa aparência
       parada. */
    @supports (-webkit-touch-callout: none) {
      .faixa-foto-caixa {
        height: calc(var(--altura-mobile-svh) * 2);
      }
      .faixa-foto {
        position: sticky;
        top: 0;
        background-attachment: scroll;
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .faixa-foto { background-attachment: scroll; position: static; }
    .faixa-foto-caixa { height: auto; }
  }
</style>
