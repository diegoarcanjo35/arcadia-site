---
/**
 * Faixa de fotografia entre seções, fixa enquanto o texto rola.
 *
 * Mesmo efeito da capa de página, em altura menor. É o que dá o ritmo às
 * páginas internas do site anterior: bloco de texto, faixa de foto, bloco de
 * texto. A foto não ilustra o parágrafo ao lado — ela serve de respiro entre
 * um assunto e outro.
 *
 * Decorativa por definição: `alt` vazio e `aria-hidden`. Descrever "sala de
 * atendimento" a cada respiro não ajuda quem usa leitor de tela, atrapalha.
 */
/**
 * `alturaMobile`: normalmente um número (percentual de altura de tela) — o
 * componente monta as duas variantes (vh e svh) sozinho, ver comentário no
 * media query abaixo sobre por que as duas existem. Também aceita uma string
 * com unidade própria (ex.: "730px"), para o caso em que o original usa uma
 * altura fixa igual no mobile e no desktop (min-height do wp-block-cover não
 * muda por breakpoint) — aí não faz sentido nenhuma das duas variantes vh.
 */
const { foto, altura = '42vh', alturaMobile = 30, class: classeExtra } = Astro.props;
const alturaMobileFixa = typeof alturaMobile !== 'number';
const alturaMobileVh = alturaMobileFixa ? alturaMobile : `${alturaMobile}vh`;
const alturaMobileSvh = alturaMobileFixa ? alturaMobile : `${alturaMobile}svh`;
---
<div
  class:list={['faixa-foto', classeExtra]}
  style={`--altura: ${altura}; --altura-mobile: ${alturaMobileVh}; --altura-mobile-svh: ${alturaMobileSvh}; background-image: url(${foto})`}
  aria-hidden="true"
></div>

<style>
  .faixa-foto {
    min-height: var(--altura);
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    background-color: var(--tinta);
  }

  @media (max-width: 900px) {
    .faixa-foto {
      /* Volta pra scroll no mobile. A regra do site anterior (.has-parallax
         { background-attachment: fixed }) de fato não tem breakpoint que
         desligue isso no CSS — mas eu só tinha conferido essa regra lendo
         o CSS e testando em Chrome desktop, nunca num iPhone de verdade.
         O Safari do iPhone ignora background-attachment:fixed há anos (bug
         conhecido, documentado antigamente neste mesmo componente antes de
         eu "corrigir" errado) — ou seja, o site anterior TAMBÉM cai pra
         scroll no celular de fato, só que silenciosamente, via bug do
         navegador, não porque o CSS pedia isso. Deixar fixed explícito
         aqui não reproduz esse comportamento com segurança: em vez de cair
         limpo pra scroll, pode renderizar de forma inconsistente/quebrada
         (a cliente reportou a faixa "sobrepondo" as outras seções, only no
         celular — nunca reproduzi isso no Chrome, mas bate exatamente com
         esse tipo de bug). Scroll explícito aqui garante o comportamento
         seguro em vez de depender de como cada versão do Safari lida com
         fixed. */
      background-attachment: scroll;
      /* svh, não só vh: no Safari mobile a barra de endereço recolhe ao
         rolar e vh muda de valor junto, fazendo a faixa "pular" de
         tamanho — svh usa a menor altura possível e fica estável. */
      min-height: var(--altura-mobile);
      min-height: var(--altura-mobile-svh);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .faixa-foto { background-attachment: scroll; }
  }
</style>
