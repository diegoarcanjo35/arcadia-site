---
const { sobreImagem = false } = Astro.props;
const rota = Astro.url.pathname;
/**
 * Os itens do site anterior, com os mesmos nomes e na mesma ordem —
 * inclusive "Home", que estava em inglês lá e continua aqui. Menu é memória
 * muscular: quem já visitou procura a palavra onde ela estava.
 *
 * "Equipe" subiu para o topo a pedido direto (antes só existia no rodapé,
 * porque o site anterior não tinha essa página) — entra antes de "Contato".
 * Artigos continua só no rodapé.
 */
const itens = [
  { href: '/', rotulo: 'Home' },
  { href: '/a-arcadia', rotulo: 'A Arcádia' },
  { href: '/servicos', rotulo: 'Serviços' },
  { href: '/oficinas', rotulo: 'Oficinas' },
  { href: '/equipe', rotulo: 'Equipe' },
  { href: '/contato', rotulo: 'Contato' },
];
const ativo = (href) => (href === '/' ? rota === '/' : rota.startsWith(href));
---
<header class:list={{ 'sobre-imagem': sobreImagem }}>
  <div class="faixa">
    <a class="marca" href="/" aria-label="Arcádia Psicologia, página inicial">
      {/* PNG e não SVG: a marca da clínica tem sombra projetada, e é ela que
          tira o desenho do "chapado". O vetor plano continua no projeto para
          onde o fundo é escuro. */}
      <img src="/logo-sombra.png" alt="" width="300" height="274" />
    </a>

    {/* Só existe visualmente no mobile (ver CSS) — no desktop o menu inteiro
        já cabe na faixa. Mesmo padrão do site anterior: ícone de duas barras
        vira "X" quando aberto, medido ao vivo (24×24px, canto superior
        direito, mesma cor do menu). */}
    <button
      type="button"
      class="alterna-menu"
      aria-expanded="false"
      aria-controls="menu-principal"
      aria-label="Abrir menu"
    >
      <svg class="icone-abrir" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 7.5h16v1.5H4z"></path>
        <path d="M4 15h16v1.5H4z"></path>
      </svg>
      <svg class="icone-fechar" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M5.6 4.5 4.5 5.6l6.4 6.4-6.4 6.4 1.1 1.1 6.4-6.4 6.4 6.4 1.1-1.1-6.4-6.4 6.4-6.4-1.1-1.1-6.4 6.4z"></path>
      </svg>
    </button>

    <nav id="menu-principal" aria-label="Principal">
      <ul>
        {itens.map((i) => (
          <li>
            <a href={i.href} aria-current={ativo(i.href) ? 'page' : undefined}>{i.rotulo}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  /**
   * Um cabeçalho por página — não precisa delegação nem cuidado com múltiplas
   * instâncias. O toggle é só troca de classe e atributo; sem framework,
   * porque é a única interatividade do cabeçalho inteiro.
   */
  const botao = document.querySelector<HTMLButtonElement>('.alterna-menu');
  const nav = document.getElementById('menu-principal');

  botao?.addEventListener('click', () => {
    const aberto = botao.getAttribute('aria-expanded') === 'true';
    botao.setAttribute('aria-expanded', String(!aberto));
    botao.setAttribute('aria-label', aberto ? 'Abrir menu' : 'Fechar menu');
    nav?.classList.toggle('aberto', !aberto);
  });

  // Trocar de página com o menu aberto (ou redimensionar para desktop) não
  // pode deixar o painel preso aberto por trás do conteúdo novo.
  nav?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      botao?.setAttribute('aria-expanded', 'false');
      botao?.setAttribute('aria-label', 'Abrir menu');
      nav.classList.remove('aberto');
    })
  );
</script>

<style>
  header {
    position: relative;
    border-bottom: 1px solid var(--linha);
    background: var(--papel);
  }
  /* Igual ao cabeçalho do site anterior na Home: sem faixa própria, flutua
     transparente sobre a foto/vídeo de capa. A cor da marca (o PNG com
     sombra) já é a mesma do site anterior nesse contexto — só o menu muda
     de cor, para a mesma que o antigo usava sobre a imagem (--ocre). */
  header.sobre-imagem {
    position: absolute;
    inset-inline: 0;
    top: 0;
    z-index: 5;
    border-bottom: 0;
    background: transparent;
  }
  header.sobre-imagem nav a { color: var(--ocre); }
  header.sobre-imagem nav a:hover,
  header.sobre-imagem nav a[aria-current='page'] { color: var(--creme); border-bottom-color: var(--creme); }
  /* Tamanhos medidos direto no site anterior via getBoundingClientRect/
     getComputedStyle, não estimados: marca a 213×194px, menu a 16.8px. */
  header.sobre-imagem .marca img { height: 194px; }
  header.sobre-imagem nav a { font-size: 16.8px; }
  @media (max-width: 560px) {
    header.sobre-imagem .marca img { height: 130px; }
    header.sobre-imagem nav a { font-size: var(--t-sm); }
  }
  .faixa {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--e-2) var(--e-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--e-3);
    flex-wrap: wrap;
  }
  .marca img { display: block; height: 62px; width: auto; }

  nav ul {
    list-style: none;
    display: flex;
    gap: var(--e-3);
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
  }
  nav a {
    text-decoration: none;
    color: var(--corpo);
    font-size: var(--t-sm);
    letter-spacing: 0.01em;
    padding-bottom: 2px;
    border-bottom: 1.5px solid transparent;
  }
  nav a:hover { color: var(--terracota); }
  nav a[aria-current='page'] {
    color: var(--terracota);
    border-bottom-color: var(--ocre);
  }

  /* Botão hambúrguer: só existe no mobile — no desktop o menu inteiro cabe
     na faixa, então fica fora do fluxo (display:none) em vez de escondido só
     visualmente, que deixaria um alvo de toque fantasma no caminho do tab. */
  .alterna-menu {
    display: none;
    background: none;
    border: 0;
    padding: 0;
    margin-left: auto;
    cursor: pointer;
    color: var(--corpo);
  }
  .alterna-menu svg { display: block; fill: currentColor; }
  .alterna-menu .icone-fechar { display: none; }
  .alterna-menu[aria-expanded='true'] .icone-abrir { display: none; }
  .alterna-menu[aria-expanded='true'] .icone-fechar { display: block; }
  header.sobre-imagem .alterna-menu { color: var(--ocre); }

  @media (max-width: 720px) {
    .faixa { flex-wrap: nowrap; }
    .alterna-menu { display: block; }

    /* Painel flutuante, não texto correndo — medido ao vivo no site
       anterior: caixa branca logo abaixo do cabeçalho, com margem nas
       laterais (não cola nas bordas da tela), links empilhados à esquerda,
       acima de tudo (z-index alto) e fora do fluxo até ser aberto.
       `position:absolute` a partir do próprio `header` (relative — ver acima)
       em vez de um valor fixo de altura: assim o painel encosta exatamente
       embaixo do cabeçalho não importa a altura real dele, sem número mágico
       para manter sincronizado — o `--altura-cabecalho` fixo já causou esse
       problema antes, quando o menu ainda quebrava linha no mobile. */
    nav { display: contents; }
    nav ul {
      display: none;
      position: absolute;
      top: 100%;
      left: var(--e-3);
      right: var(--e-3);
      z-index: 100;
      flex-direction: column;
      gap: 0;
      background: var(--papel);
      border-radius: var(--raio);
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
      padding: var(--e-2) var(--e-3);
    }
    nav.aberto ul { display: flex; }
    nav li { border-bottom: 1px solid var(--linha); }
    nav li:last-child { border-bottom: 0; }
    nav a {
      display: block;
      padding: var(--e-2) 0;
      color: var(--corpo);
    }
    nav a[aria-current='page'] { border-bottom-color: var(--ocre); }
    /* O creme do cabeçalho "sobre-imagem" é pensado pra contraste sobre foto
       escura (ver regras fora deste media query) — aqui o painel é claro e
       opaco, então tanto o link normal quanto o ativo precisam de volta à
       cor legível padrão, sem herdar o tratamento do desktop. */
    header.sobre-imagem nav a,
    header.sobre-imagem nav a:hover,
    header.sobre-imagem nav a[aria-current='page'] { color: var(--terracota); }
  }
</style>

<style is:global>
  /**
   * A altura do cabeçalho, publicada para quem precisa dela.
   *
   * Quem precisa é a capa de tela cheia: ela tem que ocupar exatamente o que
   * sobra da janela abaixo daqui, senão ou o título cai fora da tela ou uma
   * tira da foto seguinte aparece embaixo. Sem esse número, o cálculo vira
   * chute.
   *
   * Fica aqui, e não na folha de estilo geral, de propósito: é o cabeçalho que
   * define a própria altura, e quem mexer no menu ou no tamanho da marca vê
   * este bloco na mesma tela. Os valores saíram de medição, não de estimativa —
   * o menu passa a ocupar duas linhas em 480px e três em 390px.
   *
   * Se um dia isto sair de sincronia, o efeito é cosmético e visível: a capa
   * fica alguns pixels mais alta ou mais baixa. Nada quebra calado.
   */
  :root { --altura-cabecalho: 95px; }
  @media (max-width: 560px) { :root { --altura-cabecalho: 147px; } }
  @media (max-width: 440px) { :root { --altura-cabecalho: 191px; } }
</style>
