---
import Base from '../layouts/Base.astro';
import CardOficina from '../components/CardOficina.astro';
import Revelar from '../components/Revelar.astro';
import { listarOficinas, listarArtigos } from '../lib/dados.js';

export const prerender = false;

const oficinas = await listarOficinas();
const abertas = oficinas.filter((o) => ['inscricoes_abertas', 'ultimas_vagas'].includes(o.status));
const destaque = abertas.slice(0, 3);
const artigos = (await listarArtigos()).slice(0, 4);

/**
 * Os textos abaixo são da clínica, transcritos do site anterior sem uma
 * palavra alterada. Ficam no código, e não no banco, porque a home nunca foi
 * editável pelo painel — as páginas institucionais são. Se um dia a clínica
 * quiser mexer nisto sozinha, o caminho é o mesmo das outras: uma chave em
 * `conteudos` e a tela de Páginas passa a listá-la.
 */
const SERVICOS = [
  {
    nome: 'ART&CLÍNICA',
    texto:
      'Arcádia Art&Clínica oferece atendimentos individuais, de casais, famílias e grupos, com foco na promoção da saúde mental e no fortalecimento dos vínculos interpessoais. Combinando técnicas tradicionais de psicoterapia com abordagens criativas.',
  },
  {
    nome: 'ART&MÉTRICA',
    texto:
      'Arcádia Art&Métrica, serviço de avaliação psicológica da Arcádia, oferece um processo completo e criterioso, baseado em entrevistas, observações e testes psicológicos validados pelo Conselho Federal de Psicologia (CFP).',
  },
  {
    nome: 'ART&TERAPIA',
    texto:
      'Arcádia ART&TERAPIA oferece um espaço dedicado à expressão emocional através da arte, permitindo que sentimentos e experiências que, muitas vezes, são difíceis de verbalizar, sejam trabalhados de forma segura e criativa.',
  },
];
---
<Base
  titulo={null}
  descricao="Clínica de psicologia em Brasília: atendimento clínico, avaliação psicológica e oficinas de arteterapia."
  cabecalhoSobreImagem
>
  {/* ------------------------------------------------------------- capa */}
  {/* Igual ao site anterior: o cabeçalho abre com uma FOTO parada da mesma
      cena dos arcos (post1-4.png lá, capa-arcos.jpg aqui) — não o vídeo. O
      vídeo só entra depois, embaixo, junto com a seção "A Arcádia". Sem
      texto por cima: o título grande e os botões que existiam aqui antes
      não vêm do site anterior — foram adicionados numa fase posterior e não
      fazem parte da réplica. */}
  <section class="capa">
    <img class="foto-capa" src="/capa-arcos-vertical.jpg" alt="" width="720" height="990" fetchpriority="high" />
    <img class="foto-capa desktop" src="/capa-arcos.jpg" alt="" width="960" height="528" fetchpriority="high" />
  </section>

  {/* -------------------------------------------------------- a arcádia */}
  {/* Aqui sim entra o vídeo — é onde ele fica no site anterior, ao lado do
      bloco "A Arcádia", com a legenda em itálico sobreposta (a pedido da
      clínica, em vez de legenda solta abaixo, que era o tratamento antigo). */}
  <section class="faixa creme">
    <div class="miolo dupla-arcadia">
      <Revelar>
        <div>
          <figure class="foto-arcadia">
            <video
              class="video-arcadia"
              poster="/capa-arcos.jpg"
              autoplay
              muted
              loop
              playsinline
              disablepictureinpicture
            >
              <source src="/capa-arcos.mp4" type="video/mp4" />
            </video>
          </figure>
          {/* Legenda simples embaixo, sem véu nem sobreposição — é assim que o
              site anterior mostra essa frase (fundo claro, não sobre a imagem). */}
          <p class="legenda-arcadia">
            Arcádia representa um refúgio de paz, simplicidade e harmonia com a
            natureza, distante das inquietações do mundo moderno.
          </p>
        </div>
      </Revelar>
      <Revelar>
        <div class="texto-arcadia">
          <h2 class="titulo-secao">A Arcádia</h2>
          <p>
            O termo “Arcádia” tem suas raízes na mitologia e na geografia da
            Grécia Antiga. Originalmente, Arcádia era uma região montanhosa no
            centro do Peloponeso, conhecida por suas paisagens naturais
            intocadas e pela simplicidade de seus habitantes. Ao longo do tempo,
            Arcádia se tornou um símbolo poético e idealizado de um paraíso
            pastoral, representando um lugar de harmonia, beleza natural e
            tranquilidade.
          </p>
          <p>
            Na literatura e na arte, Arcádia é frequentemente retratada como um
            refúgio utópico, onde a vida é simples e em comunhão com a natureza.
            Essa visão bucólica foi particularmente popularizada durante o
            Renascimento e o período Neoclássico, quando poetas e artistas
            idealizaram Arcádia como um escape dos problemas e complexidades da
            vida urbana e moderna.
          </p>
          <p class="fecho">
            Arcádia simboliza um ideal de paz, simplicidade e conexão com a
            natureza, um lugar onde a vida é pura e descomplicada, longe das
            preocupações e tensões do mundo moderno.
          </p>
          <p class="acao-secao"><a class="botao" href="/a-arcadia">Saiba +</a></p>
        </div>
      </Revelar>
    </div>
  </section>

  {/* ------------------------------------------------------ o que fazemos */}
  <section class="faixa">
    <div class="miolo">
      <Revelar>
        <h2 class="titulo-secao">O que fazemos</h2>
        <p class="subtitulo-secao">Conheça nossos serviços e veja qual se encaixa em sua busca.</p>
      </Revelar>

      {/*
        Grade que se ajusta em vez de três colunas fixas. No site anterior a
        terceira coluna — ART&TERAPIA — ficava cortada na borda direita em telas
        de 1920px. Os três nomes formam um conjunto; um deles cortado desfaz o
        conjunto.
      */}
      <ul class="servicos">
        {SERVICOS.map((s) => (
          <li>
            <Revelar>
              <h3>{s.nome}</h3>
              <p>{s.texto}</p>
            </Revelar>
          </li>
        ))}
      </ul>

      <p class="acao-secao"><a class="botao" href="/servicos">Saiba +</a></p>
    </div>
  </section>

  {/* ------------------------------------------------------------- tese */}
  <section class="faixa creme-suave">
    <div class="miolo">
      <Revelar>
        <blockquote class="tese">
          Um espaço onde a psicologia encontra a arte como um caminho para o
          autoconhecimento
        </blockquote>
      </Revelar>
    </div>
  </section>

  {/* ---------------------------------------------------------- oficinas */}
  <section class="faixa terracota">
    <div class="miolo">
      {/* Cabeçalho da faixa, como no site anterior: a terracota não abre em
          "Oficinas", abre em "Atividades e conteúdos" — é ela que anuncia que
          dali para baixo vêm as oficinas E os artigos. Sem esta linha, o bloco
          de artigos aparece depois sem nada tê-lo apresentado. */}
      <Revelar>
        <div class="texto-claro cabecalho-faixa">
          <h2 class="titulo-secao">Atividades e conteúdos</h2>
          <p class="subtitulo-secao">Aqui você acessa oficinas e artigos.</p>
        </div>
      </Revelar>

      <div class="dupla">
        <Revelar>
          <div class="texto-claro">
            <h2 class="titulo-secao">Oficinas</h2>
            <p>
              As oficinas de arteterapia da Arcádia oferecem um espaço acolhedor
              para a expressão e o autoconhecimento, utilizando a arte como meio
              de explorar emoções e fortalecer vínculos. Com atividades como
              colagem, leitura e escrita criativa, desenhos e modelagem com
              argila, as oficinas criam um ambiente seguro para quem busca
              reconexão pessoal ou deseja aprimorar relações interpessoais.
            </p>
            <p>
              O trabalho em grupo, central nas oficinas, promove troca de
              experiências, empatia e apoio mútuo, ajudando os participantes a
              superar barreiras internas e se expressarem espontaneamente. O
              grupo atua como uma rede de inspiração e suporte, ampliando o
              potencial criativo e emocional de cada participante.
              Cada encontro é uma oportunidade única de descoberta e crescimento,
              enriquecida pela interação coletiva.
            </p>
            <p class="acao-secao"><a class="botao claro" href="/oficinas">Saiba +</a></p>
          </div>
        </Revelar>

        <Revelar>
          {/*
            Esta é a colagem que o site anterior exibia a 579×558 a partir de um
            arquivo de 211×300 — quase três vezes o tamanho real, e ainda
            espremida num quadrado que não é a proporção dela. Aqui entra o
            maior arquivo que existe na biblioteca, na proporção verdadeira.
            Mesma imagem, mesma escolha; o que sai é a distorção.
          */}
          <figure class="colagem">
            <img
              src="/home/colagem-oficinas.webp"
              alt="Colagem em papel com recortes de revista, letras e uma libélula sobre fundo amarelo e vermelho."
              width="427"
              height="607"
              loading="lazy"
              decoding="async"
            />
          </figure>
        </Revelar>
      </div>
    </div>
  </section>

  {/* Turmas abertas: isto o site anterior não tinha. Lá as seis oficinas
      viviam dentro de uma página só, sem data nem inscrição. */}
  {destaque.length > 0 && (
    <section class="faixa">
      <div class="miolo">
        <div class="cabeca">
          <h2 class="titulo-secao">Turmas abertas</h2>
          <a href="/oficinas">Todas as oficinas →</a>
        </div>
        <div class="grade">
          {destaque.map((o) => <CardOficina oficina={o} />)}
        </div>
      </div>
    </section>
  )}

  {/* ---------------------------------------------------------- artigos */}
  {/* Layout do site anterior: a foto do post ao lado da lista, fundo claro —
      não atrás do texto como fundo de tela cheia. */}
  {artigos.length > 0 && (
    <section class="faixa creme">
      <div class="miolo dupla-artigos">
        <Revelar>
          <figure class="foto-artigos">
            <img src="/home/passaro.webp" alt="" width="1080" height="1080" loading="lazy" decoding="async" />
          </figure>
        </Revelar>
        <Revelar>
          <div class="lista-artigos">
            <h2 class="titulo-secao">Artigos</h2>
            <ul>
              {artigos.map((a) => (
                <li><a href={`/artigos/${a.slug}`}>{a.titulo}</a></li>
              ))}
            </ul>
            <p class="acao-secao"><a class="botao" href="/artigos">Todos os textos</a></p>
          </div>
        </Revelar>
      </div>
    </section>
  )}
</Base>

<style>
  /* ------------------------------------------------------------- capa */
  /* Só a foto, sem texto por cima — ver comentário no HTML. */
  .capa {
    background: var(--tinta);
    overflow: hidden;
    min-height: 90vh;
    display: flex;
  }
  .foto-capa {
    width: 100%;
    height: 100%;
    min-height: 90vh;
    object-fit: cover;
    display: block;
  }
  .foto-capa.desktop { display: none; }
  @media (min-width: 900px) {
    .foto-capa { display: none; }
    .foto-capa.desktop { display: block; }
  }
  @media (max-width: 900px) {
    .capa, .foto-capa { min-height: 60vh; }
  }

  /* --------------------------------------------------- faixas sangradas */
  /* A alternância creme / branco / terracota atravessando a tela inteira é o
     ritmo do site anterior. O miolo é que tem largura máxima, não a faixa. */
  /* A faixa sem modificador é o ponto claro da onda entre dois blocos creme.
     Nunca branco puro. */
  .faixa { padding: var(--e-6) var(--e-3); background: var(--papel); }
  .miolo { max-width: 1120px; margin: 0 auto; }

  .creme { background: var(--creme); }
  .creme-suave { background: var(--creme-suave); border-block: 1px solid var(--linha); }
  .terracota { background: var(--terracota); }

  .titulo-secao {
    font-size: var(--t-2xl);
    margin: 0 0 var(--e-2);
    color: var(--terracota);
  }
  .subtitulo-secao { margin: 0 0 var(--e-4); color: var(--corpo); }
  .acao-secao { margin: var(--e-3) 0 0; }

  .texto-arcadia p { margin: 0 0 1em; max-width: 62ch; }
  .fecho { max-width: 62ch; margin: var(--e-2) 0 0; font-size: var(--t-lg); color: var(--tinta); }

  /* ---------------------------------------------------------- a arcádia */
  .dupla-arcadia {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: var(--e-5);
    align-items: center;
  }
  .foto-arcadia {
    position: relative;
    margin: 0;
    border-radius: var(--raio);
    overflow: hidden;
    aspect-ratio: 960 / 528;
  }
  .foto-arcadia img,
  .foto-arcadia video { width: 100%; height: 100%; object-fit: cover; display: block; }
  .legenda-arcadia {
    margin: var(--e-2) 0 0;
    padding: 0 var(--e-2);
    color: var(--tinta);
    font-family: var(--fonte-titulo);
    font-style: italic;
    text-align: center;
    font-size: var(--t-lg);
    line-height: 1.4;
  }

  /* ------------------------------------------------------- os três ART& */
  .servicos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--e-3);
  }
  .servicos li {
    background: var(--creme);
    border-radius: var(--raio);
    padding: var(--e-3);
  }
  .servicos h3 {
    font-family: var(--fonte-texto);
    font-size: var(--t-sm);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--terracota);
    margin: 0 0 var(--e-2);
  }
  .servicos p { margin: 0; font-size: var(--t-sm); }

  /* ------------------------------------------------------------- tese */
  .tese {
    font-family: var(--fonte-titulo);
    font-style: italic;
    font-size: clamp(1.4rem, 2.6vw, 2.1rem);
    line-height: 1.35;
    text-align: center;
    color: var(--terracota);
    max-width: 30ch;
    margin: 0 auto;
    quotes: '“' '”';
  }
  .tese::before { content: open-quote; }
  .tese::after { content: close-quote; }

  /* ---------------------------------------------------------- oficinas */
  .dupla {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: var(--e-5);
    align-items: center;
  }
  /* Cabeçalho da faixa terracota. O "Oficinas" logo abaixo é o assunto; este é
     o anúncio do conjunto, então vem menor e mais espaçado do que ele — se os
     dois tiverem o mesmo peso, a pessoa lê dois títulos e não uma hierarquia. */
  .cabecalho-faixa { margin-bottom: var(--e-5); }
  .cabecalho-faixa .subtitulo-secao { color: #f0e2d4; margin-bottom: 0; }

  .texto-claro { color: #f6ede2; }
  .texto-claro .titulo-secao { color: var(--creme); }
  .texto-claro p { margin: 0 0 1em; }

  .colagem { margin: 0; }
  .colagem img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--raio);
  }

  /* Botão claro sobre a terracota: o terracota-sobre-terracota do site
     anterior sumia no fundo. */
  .botao.claro {
    background: var(--creme);
    border-color: var(--creme);
    color: var(--terracota);
  }
  .botao.claro:hover { background: #fff; border-color: #fff; color: var(--terracota-escuro); }

  /* ----------------------------------------------------------- cartões */
  .cabeca {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--e-2);
    margin-bottom: var(--e-3);
    flex-wrap: wrap;
  }
  .cabeca a { text-decoration: none; font-size: var(--t-sm); }
  .grade {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--e-3);
  }

  /* ---------------------------------------------------------- artigos */
  /* Layout do site anterior: foto ao lado da lista, sobre fundo creme —
     não atrás do texto como pano de fundo de tela cheia. */
  .dupla-artigos {
    display: grid;
    grid-template-columns: 1fr 0.8fr;
    gap: var(--e-5);
    align-items: center;
  }
  .foto-artigos { margin: 0; }
  .foto-artigos img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: var(--raio);
  }
  .lista-artigos { max-width: 46ch; }
  .lista-artigos ul { list-style: none; margin: 0; padding: 0; }
  .lista-artigos li { border-bottom: 1px solid var(--linha); }
  .lista-artigos ul a {
    display: block;
    padding: 0.7rem 0;
    color: var(--tinta);
    text-decoration: none;
    font-family: var(--fonte-titulo);
    font-size: var(--t-lg);
  }
  .lista-artigos ul a:hover { color: var(--terracota); }

  @media (max-width: 900px) {
    .dupla-artigos { grid-template-columns: 1fr; }
    .foto-artigos { max-width: 380px; margin: 0 auto; }
  }

  /* ------------------------------------------------------------ telas */
  @media (max-width: 900px) {
    /* "Quase não vejo a imagem por trás" — a Wanda, olhando no celular.
       Estava certa: numa tela estreita o texto ocupava o meio da cena e o véu
       escuro cobria o resto, então dos arcos não sobrava quase nada.
       A correção é dar à imagem um pedaço só dela. O texto desce e começa
       depois dos primeiros 44% da altura da tela; acima disso é foto e mais
       nada. Não é altura fixa: se a frase crescer, a capa cresce junto e o
       espaço da imagem continua o mesmo.
       svh em vez de vh porque no celular a barra do navegador aparece e some,
       e vh muda de valor junto — a capa "pulava" durante a rolagem. */
    .capa {
      min-height: 0;
      align-items: flex-end;
    }
    .capa .dentro {
      padding-top: 28vh;
      padding-top: 28svh;
    }
    .dupla { grid-template-columns: 1fr; gap: var(--e-4); }
    .colagem { max-width: 380px; }
    .dupla-arcadia { grid-template-columns: 1fr; }
  }
  @media (max-width: 720px) {
    .faixa { padding: var(--e-5) var(--e-3); }
    .capa .dentro { padding: var(--e-5) var(--e-3); padding-top: 28svh; }
  }
</style>
