---
import Base from '../layouts/Base.astro';
import AguardandoConteudo from '../components/AguardandoConteudo.astro';
import Prosa from '../components/Prosa.astro';
import { listarFacilitadoras } from '../lib/dados.js';
import { retratoDe } from '../lib/artes.js';

export const prerender = false;

// Esta é a página que resolve, de forma permanente, o pedido original da
// clínica de "incluir uma bio": a equipe passa a ser cadastro, e cada
// profissional nova aparece aqui sem obra no site.
const equipe = await listarFacilitadoras();
---
<Base
  titulo="Equipe"
  descricao="As profissionais da Arcádia Psicologia, com formação e registro no Conselho Regional de Psicologia."
>
  <div class="topo">
    <div class="dentro">
      <h1>Equipe</h1>
      <p>Quem conduz os atendimentos e as oficinas da Arcádia.</p>
    </div>
  </div>

  <div class="corpo">
    {equipe.length > 0 ? (
      <ul class="lista">
        {equipe.map((p) => (
          <li class="pessoa">
            <div class="foto">
              {retratoDe(p)
                ? <img src={retratoDe(p)} alt={`Retrato de ${p.nome}`} loading="lazy" decoding="async" />
                : <div class="sem-foto" aria-hidden="true"><img src="/simbolo.svg" alt="" /></div>}
            </div>
            <div class="dados">
              <h2>{p.nome}</h2>
              <p class="crp">Psicóloga · CRP {p.crp}</p>
              {/* Prosa, não um <p> só: a Wanda pediu espaço de respiro no
                  texto — bio como parágrafo único vira parede de texto. O
                  textarea do painel já aceita linha em branco entre
                  parágrafos, só faltava a página pública quebrar nelas. */}
              {p.bio && <Prosa texto={p.bio} />}
            </div>
          </li>
        ))}
      </ul>
    ) : (
      <AguardandoConteudo
        itens={[
          'biografia, foto e CRP de cada profissional',
          'a bio da Janaína, pendente de envio pela clínica',
        ]}
      />
    )}
  </div>
</Base>

<style>
  .topo { background: var(--creme); border-bottom: 1px solid var(--linha); }
  .dentro { max-width: 1120px; margin: 0 auto; padding: var(--e-5) var(--e-3); }
  h1 { font-size: var(--t-3xl); margin: 0 0 var(--e-1); }
  .dentro p { margin: 0; font-size: var(--t-lg); max-width: 54ch; }

  .corpo { max-width: 1120px; margin: 0 auto; padding: var(--e-4) var(--e-3) 0; }
  .lista { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--e-4); }
  .pessoa {
    display: grid;
    grid-template-columns: 160px 1fr;
    gap: var(--e-3);
    align-items: start;
    padding-bottom: var(--e-3);
    border-bottom: 1px solid var(--linha);
  }
  /* Máscara redonda, a pedido direto da Wanda — não o --raio (4px, quase
     reto) padrão do resto do site. */
  .foto { aspect-ratio: 1; border-radius: 50%; overflow: hidden; background: var(--creme); }
  .foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .sem-foto { width: 100%; height: 100%; display: grid; place-items: center; }
  .sem-foto img { width: 42px; height: auto; opacity: 0.28; object-fit: contain; }

  h2 { font-size: var(--t-xl); margin: 0 0 0.2rem; }
  .crp { margin: 0 0 var(--e-2); font-size: var(--t-sm); color: var(--terracota); }

  @media (max-width: 620px) {
    .pessoa { grid-template-columns: 1fr; }
    .foto { max-width: 180px; }
    h1 { font-size: var(--t-2xl); }
  }
</style>
