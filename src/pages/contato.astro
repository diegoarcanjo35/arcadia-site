---
import Base from '../layouts/Base.astro';
import { buscarConfiguracoes } from '../lib/dados.js';

// O site anterior não tinha telefone, WhatsApp, endereço, mapa nem horário —
// o único canal era um formulário de e-mail, o meio de menor taxa de resposta
// disponível para uma clínica no Brasil. Esta página existe para corrigir isso.
//
// Os valores agora vêm do painel (Páginas → Contato), não do código: mudar o
// horário de atendimento não pode depender de um deploy.
export const prerender = false;

const cfg = await buscarConfiguracoes();

const EMAIL = cfg['contato.email'] || 'wanda@meyermattos.com.br';
const WHATSAPP = (cfg['contato.whatsapp'] || '').replace(/\D/g, '') || null;
const HORARIO = cfg['contato.horario'] || null;
const INSTAGRAM = (cfg['contato.instagram'] || '').replace(/^@/, '') || null;
const ENDERECO = 'CLN 412, Bloco D, salas 102 e 103 — Brasília, DF';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Psychologist',
  name: 'Arcádia Psicologia',
  email: EMAIL,
  ...(WHATSAPP ? { telephone: `+${WHATSAPP}` } : {}),
  ...(HORARIO ? { openingHours: HORARIO } : {}),
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'CLN 412, Bloco D, salas 102 e 103',
    addressLocality: 'Brasília',
    addressRegion: 'DF',
    addressCountry: 'BR',
  },
};
---
<Base
  titulo="Contato"
  descricao="Fale com a Arcádia Psicologia. Atendimento clínico e oficinas em Brasília, presencial e online."
  cabecalhoSobreImagem
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  {/* Capa e faixa de título iguais às outras páginas internas — esta página
      não tinha nenhuma das duas, renderizava o cabeçalho sólido padrão
      direto em cima do H1. */}
  <section class="capa">
    <img class="foto-capa" src="/capa-arcos-vertical.jpg" alt="" width="720" height="990" fetchpriority="high" />
    <img class="foto-capa desktop" src="/capa-arcos.jpg" alt="" width="960" height="528" fetchpriority="high" />
  </section>

  <div class="faixa-titulo">
    <h1>Contato</h1>
  </div>

  {/* O site anterior não tem esse subtítulo — a página lá é só "Contato" e
      um formulário. Frase mantida (é conteúdo nosso, explicando os canais
      novos que o site antigo não tinha), só sem o "topo" antigo que a
      envolvia. */}
  <p class="subtitulo">Para agendar uma conversa, tirar dúvida sobre uma oficina ou falar sobre atendimento.</p>

  <div class="colunas">
    <section class="canais">
      <h2>Canais</h2>

      <dl>
        <div>
          <dt>E-mail</dt>
          <dd><a href={`mailto:${EMAIL}`}>{EMAIL}</a></dd>
        </div>

        <div>
          <dt>WhatsApp</dt>
          <dd>
            {WHATSAPP
              ? <a href={`https://wa.me/${WHATSAPP}`} rel="noopener">Abrir conversa</a>
              : <span class="pendente">a definir com a clínica</span>}
          </dd>
        </div>

        {INSTAGRAM && (
          <div>
            <dt>Instagram</dt>
            <dd>
              <a href={`https://instagram.com/${INSTAGRAM}`} rel="noopener">@{INSTAGRAM}</a>
            </dd>
          </div>
        )}

        <div>
          <dt>Endereço</dt>
          <dd>{ENDERECO}</dd>
        </div>

        <div>
          <dt>Atendimento</dt>
          <dd>{HORARIO ?? <span class="pendente">horários a definir</span>}</dd>
        </div>
      </dl>
    </section>

    <aside class="nota">
      <h2>Antes de escrever</h2>
      <p>
        Este canal é para agendamento e informações. <strong>Não descreva aqui
        queixas, sintomas ou histórico de saúde</strong> — esse tipo de conversa
        pertence ao atendimento, não a um formulário de site.
      </p>
      <p>
        Se você está em sofrimento agudo ou risco imediato, procure o CVV pelo{' '}
        <strong>188</strong>, gratuito e 24 horas, ou o serviço de emergência
        mais próximo.
      </p>
      <p class="fim">
        Como tratamos seus dados está descrito na{' '}
        <a href="/politica-de-privacidade">Política de Privacidade</a>.
      </p>
    </aside>
  </div>
</Base>

<style>
  /* Mesma capa das outras páginas internas: só a foto, sem véu nem título
     por cima — o cabeçalho fica transparente sobre ela (cabecalhoSobreImagem
     no Base). */
  .capa {
    background: var(--tinta);
    position: relative;
    overflow: hidden;
    height: 100vh;
  }
  .foto-capa {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .foto-capa.desktop { display: none; }
  @media (min-width: 900px) {
    .foto-capa { display: none; }
    .foto-capa.desktop { display: block; }
  }
  @media (max-width: 900px) {
    .capa { height: auto; aspect-ratio: 1.1; }
  }

  /* Faixa de título medida ao vivo (mesmo padrão de A Arcádia/Serviços/
     Nossa Marca): caixa sem padding próprio, cor terracota, escala fluida
     "xx-large" (40,7px no mobile a 52,3px no desktop), respiro de 30px/11px
     no mobile e 102px/39px no desktop. */
  .faixa-titulo {
    background: var(--creme);
    padding: 30px 0 11px;
  }
  @media (min-width: 900px) {
    .faixa-titulo { padding: 102px 0 39px; }
  }
  .faixa-titulo h1 {
    max-width: 800px;
    margin: 0 auto;
    background: rgb(236, 234, 223);
    color: var(--terracota);
    font-family: var(--fonte-titulo);
    font-size: clamp(2.5rem, 2.5rem + ((1vw - 0.2rem) * 1.283), 3.27rem);
    font-weight: 400;
    text-align: center;
  }

  /* Sem equivalente no site anterior (ver comentário no markup) — estilo
     simples, consistente com o resto do texto do site, não medido. */
  .subtitulo {
    max-width: 640px;
    margin: var(--e-3) auto 0;
    padding: 0 var(--e-3);
    text-align: center;
    font-size: var(--t-lg);
    color: var(--corpo);
  }

  .colunas {
    max-width: 1120px;
    margin: 0 auto;
    padding: var(--e-4) var(--e-3) 0;
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: var(--e-5);
    align-items: start;
  }
  h2 {
    font-size: var(--t-xl);
    margin: 0 0 var(--e-2);
    padding-bottom: 4px;
    border-bottom: 2px solid var(--ocre);
    display: inline-block;
  }

  dl { margin: 0; }
  dl > div {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: var(--e-2);
    padding: var(--e-2) 0;
    border-bottom: 1px solid var(--linha);
  }
  dt { font-size: var(--t-xs); text-transform: uppercase; letter-spacing: 0.1em; color: var(--apagado); }
  /* Sem min-width:0 o item de grid não encolhe abaixo do tamanho intrínseco
     do conteúdo — um e-mail comprido (uma palavra só, sem espaço pra
     quebrar) empurrava a coluna pra fora da tela em vez de quebrar linha. */
  dd { margin: 0; min-width: 0; overflow-wrap: break-word; }
  .pendente { color: var(--apagado); font-style: italic; font-size: var(--t-sm); }

  .nota {
    background: var(--creme-suave);
    border-left: 3px solid var(--terracota);
    border-radius: 0 var(--raio) var(--raio) 0;
    padding: var(--e-3);
  }
  .nota h2 { font-size: var(--t-lg); border: 0; margin-bottom: var(--e-1); }
  .nota p { font-size: var(--t-sm); margin: 0 0 var(--e-2); }
  .fim { margin-bottom: 0 !important; color: var(--apagado); }

  @media (max-width: 900px) {
    .colunas { grid-template-columns: 1fr; }
  }
</style>
