---
import Base from '../../layouts/Base.astro';
import CardOficina from '../../components/CardOficina.astro';
import { listarOficinas } from '../../lib/dados.js';

export const prerender = false;

const todas = await listarOficinas();
const abertas = todas.filter((o) => ['inscricoes_abertas', 'ultimas_vagas'].includes(o.status));
const emBreve = todas.filter((o) => o.status === 'em_breve');
// Turmas encerradas continuam visíveis: o histórico segue gerando busca orgânica.
const anteriores = todas.filter((o) => ['encerrada', 'realizada'].includes(o.status));

// Oficina publicada que ainda não teve nenhuma turma marcada. Sem este grupo
// ela sumia do índice: os filtros acima olham o status da TURMA, e quem não tem
// turma fica com status nulo, caindo fora de todos eles. O defeito só apareceu
// quando entrou o catálogo real, em que a maioria das oficinas ainda não tem
// data. A página da oficina existe e traz o formulário de aviso da próxima
// turma — o que faltava era um caminho até ela.
const semTurma = todas.filter((o) => !o.status);
---
<Base
  titulo="Oficinas"
  descricao="Oficinas terapêuticas em grupo da Arcádia Psicologia: turmas abertas, próximas turmas e edições anteriores."
  cabecalhoSobreImagem
>
  {/* Mesma capa da Home: só a foto dos arcos, sem véu nem título por cima. */}
  <section class="capa">
    <img class="foto-capa" src="/capa-arcos-vertical.jpg" alt="" width="720" height="990" fetchpriority="high" />
    <img class="foto-capa desktop" src="/capa-arcos.jpg" alt="" width="960" height="528" fetchpriority="high" />
  </section>

  {/* Título medido ao vivo no original: caixa clara centralizada (mesmo
      padrão das outras páginas internas), Cardo 52px, cor terracota — sem
      parágrafo embaixo, que era acréscimo nosso. */}
  <div class="faixa-titulo">
    <h1>Oficinas</h1>
  </div>

  {/* "Sobre nossas oficinas": existia no site anterior logo abaixo do
      título, e tinha sumido na reconstrução. Faixa de largura total, foto à
      esquerda / texto à direita, medida ao vivo no original. */}
  <div class="sobre-oficinas">
    <figure class="foto-sobre">
      <img src="/oficinas/sobre.png" alt="" width="814" height="1078" loading="lazy" decoding="async" />
    </figure>
    <div class="texto-sobre">
      <p class="titulo-sobre">Sobre nossas oficinas</p>
      <p>
        As oficinas de arteterapia da clínica Arcádia oferecem um espaço
        acolhedor para a expressão e o autoconhecimento, utilizando a arte
        como meio de explorar emoções e fortalecer vínculos. Com atividades
        como colagem, leitura e escrita, criam um ambiente seguro para quem
        busca reconexão pessoal ou deseja aprimorar relações interpessoais.
      </p>
      <p>
        O trabalho em grupo, central nas oficinas, promove troca de
        experiências, empatia e apoio mútuo, ajudando os participantes a
        superar barreiras internas e se expressarem sem medo de
        julgamentos. O grupo atua como uma rede de inspiração e suporte,
        ampliando o potencial criativo e emocional de cada participante.
      </p>
      <p>
        Cada encontro é uma oportunidade única de descoberta e crescimento,
        enriquecida pela interação coletiva.
      </p>
    </div>
  </div>

  <div class="corpo">
    {abertas.length > 0 && (
      <section>
        <h2>Inscrições abertas</h2>
        <div class="grade">{abertas.map((o) => <CardOficina oficina={o} />)}</div>
      </section>
    )}

    {emBreve.length > 0 && (
      <section>
        <h2>Próximas turmas</h2>
        <div class="grade">{emBreve.map((o) => <CardOficina oficina={o} />)}</div>
      </section>
    )}

    {semTurma.length > 0 && (
      <section>
        <h2>Também podem te interessar...</h2>
        <p class="nota">
          Estas oficinas ainda não têm turma marcada. Deixe seu contato na
          página de cada uma e avisamos quando a próxima abrir.
        </p>
        <div class="grade">{semTurma.map((o) => <CardOficina oficina={o} />)}</div>
      </section>
    )}

    {anteriores.length > 0 && (
      <section>
        <h2>Edições anteriores</h2>
        <p class="nota">
          Mantidas no ar porque continuam sendo encontradas em busca. Para ser
          avisada de uma turma nova, entre na lista de espera da oficina.
        </p>
        <div class="grade">{anteriores.map((o) => <CardOficina oficina={o} />)}</div>
      </section>
    )}

    {todas.length === 0 && <p class="vazio">Nenhuma oficina publicada no momento.</p>}
  </div>
</Base>

<style>
  /* Mesma capa da Home (ver index.astro): só a foto, sem véu, sem texto por
     cima. Altura de tela cheia, foto vertical no celular.
     margin-bottom:0 sobrescreve a regra genérica "section { margin-bottom:
     var(--e-5) }" (pensada pro ritmo entre as seções de conteúdo lá
     embaixo) — sem isso, a capa (que também é uma <section>) ganhava 64px
     de vão antes da faixa do título, sem nenhuma medida do site anterior
     por trás disso. Era essa a causa real do vão que sobrava mesmo depois
     de já ter reduzido o padding da própria faixa. */
  .capa {
    background: var(--tinta);
    position: relative;
    overflow: hidden;
    height: 100vh;
    margin-bottom: 0;
  }
  .foto-capa {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .foto-capa.desktop { display: none; }
  @media (min-width: 900px) {
    .foto-capa { display: none; }
    .foto-capa.desktop { display: block; }
  }
  /* Mesma correção da Home (ver index.astro): no site anterior a capa no
     mobile NÃO é altura de tela cheia — é o próprio cabeçalho, com altura
     definida pelo conteúdo, não pela janela. Medido ao vivo aqui: 341px
     numa tela de 375px — proporção 1,1:1, igual à Home. 60vh era estimado,
     por isso ficava maior que o site anterior. */
  @media (max-width: 900px) {
    .capa { height: auto; aspect-ratio: 1.1; }
  }

  /* Título medido no original: caixa clara (236,234,223), Cardo 52px,
     terracota, centralizada — mesma caixa das outras páginas internas. */
  .faixa-titulo {
    background: var(--creme);
    padding: 72px var(--e-3);
  }
  /* Tamanho fluido, não fixo — mesma escala do preset "xx-large" do tema
     (clamp), 40px no mobile subindo a 52.32px no desktop (medido em
     a-arcadia.astro). 52.32px fixo pra qualquer largura deixava grande
     demais no celular. */
  .faixa-titulo h1 {
    max-width: 800px;
    margin: 0 auto;
    background: rgb(236, 234, 223);
    color: var(--terracota);
    font-family: var(--fonte-titulo);
    font-size: clamp(2.5rem, 2.5rem + ((1vw - 0.2rem) * 1.283), 3.27rem);
    font-weight: 400;
    text-align: center;
    /* h1,h2,h3 no marca.css aplica -0.01em global (pensado pros títulos
       normais do site) — medido ao vivo, este título específico no site
       anterior não tem esse aperto, é letter-spacing normal. */
    letter-spacing: normal;
  }

  /* "Sobre nossas oficinas": faixa de largura total, foto à esquerda /
     texto à direita, medida ao vivo no original (mesmo padrão dos blocos de
     serviço — ver servicos.astro). Aqui o texto fica centralizado na
     vertical, não colado no topo. */
  .sobre-oficinas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    /* Sem isso, em tela bem larga as colunas crescem sem limite (nenhum
       outro bloco do site faz isso — .corpo trava em 1120px) e a proporção
       fixa da foto acima faz a faixa inteira virar uma torre, muito mais
       alta que o texto ao lado. Mesmo teto de largura do resto da página. */
    max-width: 1120px;
    margin: 0 auto;
  }
  .foto-sobre {
    position: relative;
    overflow: hidden;
    margin: 0;
    /* Pedido explícito da Wanda: essa imagem não pode cortar de jeito
       nenhum, nem a ponta de cima nem qualquer outra parte. A proporção
       fixa aqui é a do próprio arquivo (814×1078, conferido com sharp) —
       com isso object-fit:cover não tem nada pra cortar, a caixa já nasce
       do tamanho certo pra imagem inteira caber. */
    aspect-ratio: 814 / 1078;
  }
  .foto-sobre img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .texto-sobre {
    padding: 0 71px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .titulo-sobre {
    font-family: var(--fonte-titulo);
    font-style: italic;
    font-size: 40px;
    font-weight: 400;
    color: var(--terracota);
    text-align: center;
    margin: var(--e-3) 0;
  }
  .texto-sobre p:not(.titulo-sobre) {
    color: var(--terracota);
    font-size: 16.8px;
    margin: 0;
  }
  @media (max-width: 900px) {
    .sobre-oficinas { grid-template-columns: 1fr; }
    /* Altura fixa (50vh) tirada: com object-fit:cover, uma altura solta da
       proporção do arquivo corta a imagem de novo — exatamente o que a
       Wanda pediu pra nunca acontecer aqui. Sem a altura própria, herda o
       aspect-ratio de .foto-sobre (814/1078) e mostra completa em qualquer
       largura, só muda o quanto de tela ela ocupa. */
    .texto-sobre { padding: var(--e-4) var(--e-3); }
    /* Os 72px de .faixa-titulo são medida de desktop — no celular a faixa
       do original é bem mais baixa (88px de altura total, medido ao vivo),
       quase a metade do que os 72px em cima e embaixo davam aqui. Sem essa
       redução, a imagem que vem logo depois (sem gap nenhum, dos dois
       lados) parecia distante do título por a faixa inteira estar inflada,
       não por sobrar espaço de verdade entre os blocos. */
    .faixa-titulo { padding: var(--e-3) var(--e-3); }
  }

  .corpo { max-width: 1120px; margin: 0 auto; padding: var(--e-4) var(--e-3) 0; }
  section { margin-bottom: var(--e-5); }
  /* Centralizado igual à grade de cartões abaixo — display:block +
     width:fit-content em vez de inline-block porque margin:auto só
     centraliza de verdade num bloco com largura definida; inline-block não
     garante isso em todo navegador. */
  h2 {
    font-size: var(--t-xl);
    display: block;
    width: fit-content;
    margin: 0 auto var(--e-2);
    padding-bottom: var(--e-1);
    border-bottom: 2px solid var(--ocre);
  }
  /* Centralizado igual ao título acima (h2) — a caixa com max-width e
     margin:0 sem "auto" deixava o texto preso na borda esquerda enquanto o
     título já tinha sido centralizado numa correção anterior. */
  .nota { font-size: var(--t-sm); color: var(--apagado); max-width: 60ch; margin: 0 auto var(--e-3); text-align: center; }
  .grade {
    display: grid;
    /* auto-fill + 1fr fazia a única oficina esticar só a primeira coluna e
       deixava as colunas vazias seguintes reservando espaço em branco à
       direita — cartão preso no canto esquerdo, não centralizado. Com
       auto-fit (que colapsa colunas vazias) o problema já sumia, mas um
       teto fixo (345px) ainda deixava as bordas vazias quando só 1 ou 2
       oficinas cabiam numa fileira larga. Voltando a 1fr — sem o auto-fill,
       não sobra coluna fantasma — os cartões crescem pra dividir o espaço
       disponível entre eles: 1 cartão ocupa a fileira quase inteira, 2
       dividem ao meio, e assim por diante, sempre que mais entrarem. */
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    justify-content: center;
    gap: var(--e-3);
    margin-top: var(--e-2);
  }
  .vazio { color: var(--apagado); }

  @media (max-width: 720px) { h1 { font-size: var(--t-2xl); } }
</style>
