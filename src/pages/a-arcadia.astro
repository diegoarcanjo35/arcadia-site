---
import Base from '../layouts/Base.astro';
import AguardandoConteudo from '../components/AguardandoConteudo.astro';
import Prosa from '../components/Prosa.astro';
import FaixaFoto from '../components/FaixaFoto.astro';
import Revelar from '../components/Revelar.astro';
import { buscarConteudo } from '../lib/dados.js';

// Deixou de ser estática: o texto agora vem do banco e a clínica edita pelo
// painel, sem precisar de mim para trocar uma frase.
export const prerender = false;

const conteudo = await buscarConteudo('a-arcadia');
const titulo = conteudo?.titulo || 'A Arcádia';

/**
 * No site anterior, o primeiro bloco ("por que esse nome") tem frases em
 * negrito específicas — Prosa não reproduz negrito de propósito (só parágrafo
 * e "## título", ver comentário no componente). Por isso esse bloco saiu do
 * banco e virou texto fixo aqui, com o negrito exatamente como no original.
 * Os blocos seguintes ("Arcádia na Psicologia", "Ambiente Terapêutico") não
 * têm negrito lá, então continuam vindo do banco via Prosa, editáveis pelo
 * painel.
 */
const corpo = conteudo?.corpo || '';
const corteResto = '## Arcádia na Psicologia';
const indiceCorte = corpo.indexOf(corteResto);
const resto = indiceCorte >= 0 ? corpo.slice(indiceCorte).trim() : '';
---
<Base titulo={titulo} descricao="A história, a proposta e o conceito de marca da Arcádia Psicologia." cabecalhoSobreImagem>
  {/* Mesma capa da Home: só a foto dos arcos, sem véu nem título por cima —
      igual ao tratamento que a Wanda pediu para manter consistente entre as
      páginas. */}
  <section class="capa">
    <img class="foto-capa" src="/capa-arcos-vertical.jpg" alt="" width="720" height="990" fetchpriority="high" />
    <img class="foto-capa desktop" src="/capa-arcos.jpg" alt="" width="960" height="528" fetchpriority="high" />
  </section>

  <h1 class="titulo-pagina">Quem Somos</h1>

  {/* No site anterior este bloco é um "media-text" de largura ampla (1280px,
      metade texto/metade imagem, sem espaço entre as duas colunas) — não faz
      parte da coluna de conteúdo de 1120px do resto da página. Por isso mora
      fora do .corpo, como uma faixa própria. */}
  <div class="dupla-nome">
    <Revelar direcao="esquerda">
      <div class="texto-nome">
        {/* No site anterior isto NÃO é um título — é só o primeiro
            parágrafo do bloco, com "ARCÁDIA" e "POR QUE ESSE NOME?" em
            negrito, do mesmo tamanho do corpo do texto. Media como <h2> de
            40px (como estava aqui antes) deixava desproporcional — bem maior
            que no original. */}
        <p class="abre-nome"><strong>ARCÁDIA</strong> – <strong>POR QUE ESSE NOME?</strong></p>
        <p>
          O nome <strong>Arcádia</strong> foi escolhido para o nosso espaço por
          seu profundo <strong>simbolismo de paz e harmonia</strong>. Na
          mitologia e na literatura, Arcádia representa um lugar de
          serenidade, onde a vida acontece <strong>em equilíbrio com a
          natureza, longe das pressões do mundo moderno</strong>. Esse conceito
          se alinha à nossa proposta terapêutica, que busca oferecer um
          ambiente acolhedor e seguro, onde cada pessoa possa se reconectar
          consigo mesma e encontrar alívio para suas inquietações.
        </p>
        <p>
          <strong>Na psicologia, Arcádia é uma metáfora para o equilíbrio
          emocional e mental, um estado de serenidade interior que permite
          lidar melhor com desafios e ansiedades</strong>. A Arcádia se propõe
          a ser esse espaço de acolhimento e transformação, um lugar onde o
          autoconhecimento e o crescimento psicológico acontecem de forma
          respeitosa e cuidadosa, tal como o ideal arcadiano de simplicidade e
          bem-estar.
        </p>
      </div>
    </Revelar>
    <Revelar direcao="direita">
      <figure class="pintura">
        <img src="/a-arcadia/arcadismo.jpg" alt="" width="846" height="697" loading="lazy" decoding="async" />
      </figure>
    </Revelar>
  </div>

  <div class="corpo">
    {/* Link do site anterior: a página de nome ("Quem Somos") levava à página
        de marca ("Nossa Marca"). Mantido aqui pelo mesmo motivo do lá. */}
    <p class="acao-secao"><a class="botao" href="/nossa-marca">Conheça nossa marca</a></p>
  </div>

  {/* A ordem importa: no site anterior a foto do consultório vem ANTES de
      "Arcádia na Psicologia", não depois — ela separa o bloco do nome do
      bloco da psicologia, e não fecha a página. Tinha ficado no fim por
      engano. */}
  <FaixaFoto foto="/espaco/0f2a4516.webp" altura="66vh" />

  <div class="corpo">
    {resto
      ? <Prosa texto={resto} />
      : <AguardandoConteudo itens={["a origem do nome e o conceito da marca", "a abordagem de trabalho"]} />}
  </div>
</Base>

<style>
  .corpo { max-width: 1120px; margin: 0 auto; padding: var(--e-4) var(--e-3) 0; }
  /* Medido no original: o botão fica dentro de uma coluna mais estreita
     (800px), centralizada na página — não solto na borda esquerda do
     .corpo inteiro (1120px), que é como estava antes. */
  .acao-secao { max-width: 800px; margin: var(--e-3) auto 0; }

  /* Mesma capa da Home (ver index.astro): só a foto, sem véu, sem texto por
     cima. Altura de tela cheia, foto vertical no celular. */
  .capa {
    background: var(--tinta);
    position: relative;
    overflow: hidden;
    height: 100vh;
  }
  .foto-capa {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .foto-capa.desktop { display: none; }
  @media (min-width: 900px) {
    .foto-capa { display: none; }
    .foto-capa.desktop { display: block; }
  }
  @media (max-width: 900px) {
    .capa { height: 60vh; }
  }

  /* Título da página, medido ao vivo no original: cor ocre (não terracota),
     centralizado, sem caixa nem fundo — texto simples, agora logo abaixo da
     capa. O tamanho não é fixo lá — é a mesma escala fluida do preset
     "xx-large" do tema (clamp), 40px no mobile (375px) subindo até 52.32px
     no desktop (1280px+). Fixar em 52.32px pra qualquer largura deixava o
     título grande demais no celular — Wanda notou. */
  .titulo-pagina {
    color: var(--ocre);
    font-family: var(--fonte-titulo);
    font-size: clamp(2.5rem, 2.5rem + ((1vw - 0.2rem) * 1.283), 3.27rem);
    font-weight: 400;
    text-align: center;
    margin: var(--e-4) 0 var(--e-3);
  }

  /* Medido no bloco real do site anterior: faixa de 1280px, metade texto
     metade imagem (grid 1fr/1fr), sem espaço entre as colunas — não é o
     1.2fr/1fr com gap que tínhamos, que deixava a pintura menor e mais
     "apertada" do que no original. */
  .dupla-nome {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    align-items: center;
    max-width: 1280px;
    margin: 0 auto var(--e-4);
  }
  .texto-nome {
    padding: 0 var(--e-4);
  }
  .texto-nome p { margin: 0 0 1em; color: var(--terracota); }
  /* O site anterior tem a cor de contraste (terracota) como cor padrão do
     corpo inteiro — não só nos títulos. Aqui alcança o texto que vem do
     banco via Prosa (que não define cor própria de propósito). Título "##"
     também sai em 40px/peso normal e centralizado, igual ao medido lá. */
  /* Medido ao vivo no original: a coluna de texto tem 832px (não os 68ch/
     571px padrão do Prosa, que era estreito demais e forçava o título a
     quebrar em duas linhas) e os parágrafos ficam colados, sem espaço entre
     eles (margem zero, não 1em). */
  .corpo :global(.prosa) { max-width: 832px; margin: 0 auto; }
  .corpo :global(.prosa p) { color: var(--terracota); margin: 0; }
  .corpo :global(.prosa h2) {
    font-size: 40px;
    font-weight: 400;
    text-align: center;
  }
  .pintura { margin: 0; }
  .pintura img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 800px) {
    .dupla-nome { grid-template-columns: 1fr; }
    .texto-nome { padding: 0 var(--e-3); }
    /* Só no mobile: a imagem sobe para logo abaixo de "Quem Somos", antes do
       texto — no desktop (colunas lado a lado) ela continua à direita. Agora
       que os dois lados entraram num <Revelar>, o filho direto do grid é o
       .revelar (com o escopo do próprio componente) — por isso o order vai
       no filho direto via :global(), e não em .pintura, que é neta. */
    .dupla-nome > :global(:last-child) { order: -1; }
  }
</style>
