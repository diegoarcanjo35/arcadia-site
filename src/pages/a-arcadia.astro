---
import Base from '../layouts/Base.astro';
import AguardandoConteudo from '../components/AguardandoConteudo.astro';
import Prosa from '../components/Prosa.astro';
import CapaPagina from '../components/CapaPagina.astro';
import FaixaFoto from '../components/FaixaFoto.astro';
import { buscarConteudo } from '../lib/dados.js';

// Deixou de ser estática: o texto agora vem do banco e a clínica edita pelo
// painel, sem precisar de mim para trocar uma frase.
export const prerender = false;

const conteudo = await buscarConteudo('a-arcadia');
const titulo = conteudo?.titulo || 'A Arcádia';

/**
 * No site anterior, o primeiro bloco ("por que esse nome") tem frases em
 * negrito específicas — Prosa não reproduz negrito de propósito (só parágrafo
 * e "## título", ver comentário no componente). Por isso esse bloco saiu do
 * banco e virou texto fixo aqui, com o negrito exatamente como no original.
 * Os blocos seguintes ("Arcádia na Psicologia", "Ambiente Terapêutico") não
 * têm negrito lá, então continuam vindo do banco via Prosa, editáveis pelo
 * painel.
 */
const corpo = conteudo?.corpo || '';
const corteResto = '## Arcádia na Psicologia';
const indiceCorte = corpo.indexOf(corteResto);
const resto = indiceCorte >= 0 ? corpo.slice(indiceCorte).trim() : '';
---
<Base titulo={titulo} descricao="A história, a proposta e o conceito de marca da Arcádia Psicologia." cabecalhoSobreImagem>
  {/* Capa dos arcos, como em todas as páginas internas do site anterior. A foto
      do consultório que estava aqui era, lá, a faixa fixa do meio da página —
      está de volta ao lugar dela, logo abaixo do texto. */}
  <CapaPagina
    foto="/capa-arcos.jpg"
    fotoVertical="/capa-arcos-vertical.jpg"
    titulo={titulo}
    altura="cheia"
  />
  <div class="corpo">
    {/* "Quem Somos" — título do site anterior acima do texto, separado do
        título "A Arcádia" que já está na capa (os dois existiam lá: um na
        faixa, outro aqui em cima do conteúdo). */}
    <p class="pretitulo">Quem Somos</p>

    <div class="dupla-nome">
      <div class="texto-nome">
        <h2>Arcádia — por que esse nome?</h2>
        <p>
          O nome <strong>Arcádia</strong> foi escolhido para o nosso espaço por
          seu profundo <strong>simbolismo de paz e harmonia</strong>. Na
          mitologia e na literatura, Arcádia representa um lugar de
          serenidade, onde a vida acontece <strong>em equilíbrio com a
          natureza, longe das pressões do mundo moderno</strong>. Esse conceito
          se alinha à nossa proposta terapêutica, que busca oferecer um
          ambiente acolhedor e seguro, onde cada pessoa possa se reconectar
          consigo mesma e encontrar alívio para suas inquietações.
        </p>
        <p>
          <strong>Na psicologia, Arcádia é uma metáfora para o equilíbrio
          emocional e mental, um estado de serenidade interior que permite
          lidar melhor com desafios e ansiedades</strong>. A Arcádia se propõe
          a ser esse espaço de acolhimento e transformação, um lugar onde o
          autoconhecimento e o crescimento psicológico acontecem de forma
          respeitosa e cuidadosa, tal como o ideal arcadiano de simplicidade e
          bem-estar.
        </p>
      </div>
      <figure class="pintura">
        <img src="/a-arcadia/arcadismo.jpg" alt="" width="846" height="697" loading="lazy" decoding="async" />
      </figure>
    </div>

    {/* Link do site anterior: a página de nome ("Quem Somos") levava à página
        de marca ("Nossa Marca"). Mantido aqui pelo mesmo motivo do lá. */}
    <p class="acao-secao"><a class="botao" href="/nossa-marca">Conheça nossa marca</a></p>
  </div>

  {/* A ordem importa: no site anterior a foto do consultório vem ANTES de
      "Arcádia na Psicologia", não depois — ela separa o bloco do nome do
      bloco da psicologia, e não fecha a página. Tinha ficado no fim por
      engano. */}
  <FaixaFoto foto="/espaco/0f2a4516.webp" altura="66vh" />

  <div class="corpo">
    {resto
      ? <Prosa texto={resto} />
      : <AguardandoConteudo itens={["a origem do nome e o conceito da marca", "a abordagem de trabalho"]} />}
  </div>

  {/* "Psicóloga Responsável": existia no site anterior nesta mesma página
      (foto + bio da Wanda). No original o bloco inteiro (título, foto e
      texto) usa a cor de contraste da marca (terracota) — não a cor de corpo
      padrão — e a foto é quadrada, não redonda. */}
  <section class="responsavel">
    <div class="corpo">
      <h2>Psicóloga Responsável</h2>
      <figure class="retrato">
        <img src="/equipe/wanda-meyer-mattos.webp" alt="Wanda Meyer, psicóloga" width="266" height="266" loading="lazy" decoding="async" />
      </figure>
      <p>
        Seja bem-vindo(a)! Sou <strong>Wanda Meyer</strong>, psicóloga fascinada
        pela arte, pelos símbolos e pela psique. Acredito que a arte e a
        psicologia podem caminhar juntas, abrindo espaços para o
        autoconhecimento, a transformação e a construção de sentidos.
      </p>
      <p>
        Minha trajetória une Psicologia Analítica, História da Arte,
        Arteterapia e Mitologia, explorando as temáticas que nos atravessam —
        sejam elas conscientes ou não. No meu trabalho, atuo no atendimento
        clínico individual, com familiares e em grupo; na avaliação
        psicológica; e nas oficinas com Arteterapia. Aqui, a criatividade não
        é vista como um talento, mas como uma linguagem — um caminho para
        acessar o que, muitas vezes, as palavras não alcançam.
      </p>
    </div>
  </section>
</Base>

<style>
  .corpo { max-width: 1120px; margin: 0 auto; padding: var(--e-4) var(--e-3) 0; }
  .acao-secao { margin: var(--e-3) 0 0; }

  /* "Quem Somos": título separado, acima do conteúdo — existia assim no
     site anterior, numa caixa clara, distinto do título "A Arcádia" da capa. */
  .pretitulo {
    background: var(--creme-suave);
    border-radius: var(--raio);
    color: var(--terracota);
    font-family: var(--fonte-titulo);
    font-size: var(--t-3xl);
    text-align: center;
    padding: var(--e-3);
    margin: 0 0 var(--e-5);
  }

  .dupla-nome {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--e-5);
    align-items: center;
    margin-bottom: var(--e-4);
  }
  .texto-nome h2 {
    font-size: var(--t-2xl);
    color: var(--terracota);
    margin: 0 0 var(--e-2);
  }
  .texto-nome p { margin: 0 0 1em; color: var(--terracota); }
  /* O site anterior tem a cor de contraste (terracota) como cor padrão do
     corpo inteiro — não só nos títulos. Aqui alcança o texto que vem do
     banco via Prosa (que não define cor própria de propósito). */
  .corpo :global(.prosa p) { color: var(--terracota); }
  .pintura { margin: 0; }
  .pintura img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--raio);
  }
  @media (max-width: 800px) {
    .dupla-nome { grid-template-columns: 1fr; }
  }

  /* "Psicóloga Responsável": no site anterior esse bloco inteiro — título,
     foto e texto — usa a cor de contraste da marca (terracota), não a cor de
     corpo padrão. A foto lá é quadrada (só encolhida a 266px), sem recorte
     circular. */
  .responsavel {
    background: var(--creme);
    padding: var(--e-5) 0;
    margin-top: var(--e-4);
    text-align: center;
    color: var(--terracota);
  }
  .responsavel .corpo { padding-top: 0; }
  .responsavel h2 {
    font-size: var(--t-2xl);
    color: var(--terracota);
    margin: 0 0 var(--e-3);
  }
  .retrato {
    margin: 0 auto var(--e-3);
    width: 266px;
  }
  .retrato img { width: 100%; height: auto; display: block; }
  .responsavel p { max-width: 68ch; margin: 0 auto 1em; text-align: left; color: var(--terracota); }
</style>
