---
import Base from '../layouts/Base.astro';
import AguardandoConteudo from '../components/AguardandoConteudo.astro';

export const prerender = true;
---
<Base titulo="Serviços" descricao="Atendimento clínico, oficinas em grupo e demais serviços da Arcádia Psicologia.">
  <div class="topo">
    <div class="dentro"><h1>Serviços</h1></div>
  </div>
  <div class="corpo">
    <AguardandoConteudo itens={["descrição do atendimento clínico individual", "modalidades: presencial e online", "como funciona o primeiro contato"]} />
  </div>
</Base>

<style>
  .topo { background: var(--creme); border-bottom: 1px solid var(--linha); }
  .dentro { max-width: 1120px; margin: 0 auto; padding: var(--e-5) var(--e-3); }
  h1 { font-size: var(--t-3xl); margin: 0; }
  .corpo { max-width: 1120px; margin: 0 auto; padding: var(--e-4) var(--e-3) 0; }
  @media (max-width: 720px) { h1 { font-size: var(--t-2xl); } }
</style>
