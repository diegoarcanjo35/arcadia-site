---
import Base from '../layouts/Base.astro';
import FaixaFoto from '../components/FaixaFoto.astro';
import Revelar from '../components/Revelar.astro';
import { buscarConteudo } from '../lib/dados.js';

export const prerender = false;

const conteudo = await buscarConteudo('servicos');
const titulo = conteudo?.titulo || 'Serviços';

/**
 * Os três serviços, com o texto do site anterior sem uma palavra alterada —
 * inclusive o negrito nos rótulos ("Individuais:", "Casais:"...) e nas
 * palavras de fechamento, que Prosa não reproduz de propósito (só parágrafo e
 * "## título", ver componente). Por isso este texto é fixo aqui, e não vem do
 * banco: o painel não tem como editar negrito, e editar só o texto sem poder
 * tocar o negrito criaria uma versão "meio editável" mais confusa que útil.
 *
 * Cada serviço é uma faixa de largura total (a mesma foto+texto 50/50 que a
 * pintura da página A Arcádia), não mais um cartão com moldura dentro da
 * coluna de 1120px — media ANTES achava que o quadro era ilustração; no
 * site anterior ele é metade da tela, com corte (object-fit: cover), do
 * mesmo jeito nos três.
 */
---
<Base
  titulo={titulo}
  descricao="Atendimento clínico, avaliação psicológica e arteterapia na Arcádia Psicologia, em Brasília."
  cabecalhoSobreImagem
>
  {/* Mesma capa da Home: só a foto dos arcos, sem véu nem título por cima. */}
  <section class="capa">
    <img class="foto-capa" src="/capa-arcos-vertical.jpg" alt="" width="720" height="990" fetchpriority="high" />
    <img class="foto-capa desktop" src="/capa-arcos.jpg" alt="" width="960" height="528" fetchpriority="high" />
  </section>

  {/* Título da página no site anterior é "Áreas de atuação", não "Serviços"
      (esse é só o rótulo do menu). Caixa clara centralizada (800px), Cardo
      52px, cor ocre, medida ao vivo no original. */}
  <div class="faixa-titulo">
    <h1>Áreas de atuação</h1>
  </div>

  {/* Cada serviço é anunciado por uma faixa de foto do espaço, e a faixa vem
      ANTES do texto, não entre um bloco e outro. As três fotos e a ordem são
      as do site anterior — conferi uma a uma pelo endereço do arquivo.
      Altura no mobile medida ao vivo no bloco equivalente do site anterior
      (wp-block-cover has-parallax entre Art&Métrica e Art&Terapia): 812px
      num viewport de 375×812 — ou seja, 100% da altura de tela, não os
      30vh padrão do componente. */}
  <FaixaFoto foto="/espaco/0f2a4509.webp" altura="730px" alturaMobile={100} />

  <section class="servico">
    <Revelar direcao="esquerda">
      <div class="dupla-servico">
        <div class="texto-servico">
          <h2>ART&CLÍNICA</h2>
          <p>
            A Arcádia Art&Clínica oferece um espaço acolhedor, integrando
            psicoterapia e arteterapia para promover saúde mental, fortalecer
            vínculos e ressignificar experiências difíceis. Nossa abordagem
            une ciência, arte e humanismo, ajudando no autoconhecimento e no
            enfrentamento de desafios emocionais.
          </p>
          <p>
            Atendemos diferentes contextos, considerando as necessidades
            específicas de cada situação:
          </p>
          <p>
            • <strong>Individuais:</strong> Nossos atendimentos acolhem
            crianças, adolescentes e adultos, ajudando-os a enfrentar
            questões como ansiedade, baixa autoestima, dificuldades
            emocionais e momentos de transição, sempre com foco na escuta
            empática e no fortalecimento da autonomia emocional.
          </p>
          <p>
            • <strong>Casais:</strong> Auxiliamos na construção de uma
            comunicação mais clara e empática, ajudando a identificar
            padrões que geram conflitos e promovendo estratégias conjuntas
            para lidar com desafios no relacionamento, sempre respeitando os
            limites e o ritmo do casal.
          </p>
          <p>
            • <strong>Famílias:</strong> Atuamos como facilitadores do
            diálogo e da compreensão entre os membros da família, ajudando a
            identificar dinâmicas que podem ser ajustadas para promover
            harmonia e equilíbrio nas relações, com o suporte constante de
            dois profissionais para uma abordagem mais ampla e integrada.
          </p>
          <p>
            • <strong>Grupos:</strong> Promovemos espaços coletivos onde a
            troca de experiências e o fortalecimento de conexões
            interpessoais são incentivados. O trabalho em grupo valoriza o
            apoio mútuo e a construção de vínculos em um ambiente seguro e
            acolhedor.
          </p>
          <p>
            Se você busca compreender melhor suas <strong>emoções</strong>,
            enfrentar <strong>dificuldades</strong> nos relacionamentos ou
            encontrar novas formas de lidar com{' '}
            <strong>questões pessoais</strong>, estamos aqui para
            acompanhá-lo em uma jornada de equilíbrio e transformação.
          </p>
        </div>
        <figure class="quadro-cheio">
          <img
            src="/quadros/clinica.webp"
            alt="Quadro da clínica: dois círculos em espiral, lado a lado, sobre fundo escuro."
            width="900"
            height="1216"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </Revelar>
  </section>

  <FaixaFoto foto="/espaco/sala-de-grupo.webp" altura="730px" alturaMobile={100} />

  <section class="servico creme">
    <Revelar direcao="direita">
      <div class="dupla-servico">
        <div class="texto-servico">
          <h2>ART&MÉTRICA</h2>
          <p>
            A Arcádia Art&Métrica, serviço de avaliação psicológica da
            Clínica Arcádia, oferece um processo completo, criterioso e
            personalizado de avaliação. Baseamo-nos em entrevistas,
            observações e *testes psicológicos validados pelo Conselho
            Federal de Psicologia (CFP), com o objetivo de compreender cada
            pessoa em sua singularidade, indo além de um simples
            diagnóstico.
          </p>
          <p>
            Nossa abordagem é guiada pelo conceito de normalidade de J.
            Bergeret, que entende o ser humano como plural e adaptável. Para
            Bergeret, a normalidade é flexível e reflete a capacidade de
            cada pessoa de se ajustar às circunstâncias da vida. Com essa
            perspectiva, buscamos identificar não apenas os desafios, mas
            também as forças e potencialidades de cada indivíduo,
            promovendo um olhar equilibrado e acolhedor.
          </p>
          <p>
            O processo é conduzido por dois profissionais, garantindo rigor
            e abrangência em todas as etapas. Essas incluem observação do
            comportamento, aplicação de testes neuropsicológicos,
            psicométricos e de personalidade, além de escalas científicas
            validadas. Ao final, realizamos uma devolutiva, apresentando os
            resultados e oferecendo orientações sobre intervenções e apoios
            adequados para o crescimento e o autoconhecimento.
          </p>
          <p>
            Atendemos crianças a partir de dois anos, adolescentes, adultos
            e idosos, sempre respeitando o contexto, a história e as
            necessidades de cada indivíduo. Nosso compromisso é oferecer um
            processo acolhedor, transparente e adaptado, onde ciência e arte
            se unem para apoiar cada pessoa em sua jornada de
            autoconhecimento e equilíbrio.
          </p>
        </div>
        <figure class="quadro-cheio">
          <img
            src="/quadros/avaliacao.webp"
            alt="Quadro da clínica: um círculo formado por espirais em preto, creme e terracota."
            width="900"
            height="1431"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </Revelar>
  </section>

  {/* Esta é a estante onde o próprio quadro da arteterapia está encostado —
      por isso ela abre justamente o bloco ART&TERAPIA, como no site
      anterior. */}
  <FaixaFoto foto="/espaco/atendimento.webp" altura="730px" alturaMobile={100} />

  <section class="servico">
    <Revelar direcao="esquerda">
      {/* Único dos três com a imagem à esquerda — é assim no site anterior,
          não um erro de padronização. */}
      <div class="dupla-servico invertida">
        <figure class="quadro-cheio">
          <img
            src="/quadros/arteterapia.webp"
            alt="Quadro da clínica: figuras sob uma sequência de arcos, com discos suspensos no ar."
            width="900"
            height="1216"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <div class="texto-servico">
          <h2>ART&TERAPIA</h2>
          <p>
            A Arcádia ART&TERAPIA oferece um espaço único para a expressão
            emocional por meio da arte, permitindo trabalhar sentimentos
            difíceis de verbalizar de forma segura e criativa. Inspirados
            por Jung, que afirmou que “a arte é um reflexo simbólico do
            mundo interno”, ajudamos a acessar e transformar conteúdos
            profundos do inconsciente.
          </p>
          <p>
            Com técnicas como colagem, desenho e modelagem com argila, a
            ART&TERAPIA promove o contato com emoções e conflitos internos,
            facilitando sua ressignificação e o autoconhecimento. Esse
            serviço é ideal para quem busca transformar experiências
            difíceis em algo compreensível e significativo.
          </p>
          <p>
            Integrada aos serviços de ART&CLÍNICA (psicoterapia) e
            ART&MÉTRICA (avaliação psicológica), a ART&TERAPIA amplia as
            possibilidades de cuidado. Nosso objetivo é oferecer um espaço
            onde a expressão artística conecta consciente e inconsciente,
            apoiando o equilíbrio emocional e a transformação pessoal.
          </p>
        </div>
      </div>
    </Revelar>
  </section>
</Base>

<style>
  /* Mesma capa da Home (ver index.astro): só a foto, sem véu, sem texto por
     cima. Altura de tela cheia, foto vertical no celular. */
  .capa {
    background: var(--tinta);
    position: relative;
    overflow: hidden;
    height: 100vh;
  }
  .foto-capa {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .foto-capa.desktop { display: none; }
  @media (min-width: 900px) {
    .foto-capa { display: none; }
    .foto-capa.desktop { display: block; }
  }
  @media (max-width: 900px) {
    .capa { height: 60vh; }
  }

  .faixa-titulo {
    background: var(--creme);
    padding: 72px var(--e-3);
  }
  /* Tamanho não é fixo no original — é a escala fluida do preset "xx-large"
     do tema (clamp), 40px no mobile subindo até 52.32px no desktop (mesma
     medição feita em a-arcadia.astro). Fixar em 52.32px pra qualquer
     largura deixava o título grande demais e quebrando em duas linhas no
     celular, onde no original cabe numa linha só. */
  .faixa-titulo h1 {
    max-width: 800px;
    margin: 0 auto;
    background: rgb(236, 234, 223);
    color: var(--ocre);
    font-family: var(--fonte-titulo);
    font-size: clamp(2.5rem, 2.5rem + ((1vw - 0.2rem) * 1.283), 3.27rem);
    font-weight: 400;
    text-align: center;
  }

  .servico.creme { background: var(--creme); }

  /* Medido ao vivo no original: faixa de largura total (não os 1120px do
     resto do site), metade texto metade quadro, sem espaço entre as
     colunas — o quadro ocupa a altura inteira da faixa, cortado com
     object-fit: cover, não emoldurado e flutuando como um cartão. */
  .dupla-servico {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }
  .dupla-servico.invertida .texto-servico { order: 2; }
  .dupla-servico.invertida .quadro-cheio { order: 1; }

  /* Medido no original: só padding horizontal (76px), sem centralizar
     verticalmente — o texto começa colado no topo da faixa, junto com a
     imagem, não flutuando no meio de um vão vazio. */
  .texto-servico {
    padding: 0 76px;
  }
  /* Título medido no original: caixa clara (mesma cor das outras caixas do
     site), 29.6px Cardo, peso normal, centralizado — não a etiqueta
     pequena em caixa alta que tínhamos. */
  .texto-servico h2 {
    background: rgb(236, 234, 223);
    color: var(--terracota);
    font-family: var(--fonte-titulo);
    font-size: 29.6px;
    font-weight: 400;
    text-align: center;
    margin: 24.6px 0;
    padding: var(--e-2) 0;
  }
  .texto-servico p {
    color: var(--terracota);
    font-size: 16.8px;
    margin: 0 0 16.8px;
  }
  .texto-servico p:last-child { margin-bottom: 0; }

  {/* height:100% num item de grid não resolve de forma confiável quando é a
      própria imagem que teria que definir essa altura — ela cai pro tamanho
      natural dela (900×1216 etc.) em vez de cobrir a coluna de texto, que é
      quem deveria mandar na altura da faixa. Mesmo problema (e mesma
      solução) da capa da Home: absolute + inset:0 tira a imagem do cálculo
      de tamanho e deixa o texto no comando. */}
  .quadro-cheio {
    position: relative;
    overflow: hidden;
    margin: 0;
  }
  .quadro-cheio img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 900px) {
    .dupla-servico,
    .dupla-servico.invertida {
      grid-template-columns: 1fr;
    }
    /* No original, cada serviço é sempre [foto grande do espaço] → [quadro]
       → [título + texto] — o quadro nunca vem depois do texto, nem no
       bloco invertido (que antes tinha uma regra própria pondo o texto
       primeiro no mobile, ao contrário dos outros dois). Uma regra só,
       valendo pros três. */
    /* No desktop o quadro herda altura de align-items:stretch, na mesma
       linha da coluna de texto (que tem conteúdo de verdade). Empilhado no
       mobile, o quadro vira a única coisa na própria linha — e como só tem
       a imagem position:absolute dentro (ver comentário acima), essa linha
       colapsa pra 0px e a arte desaparece, venha ela antes ou depois do
       texto. Por isso a altura tem que ir no próprio .quadro-cheio agora,
       não só na imagem lá dentro. */
    .quadro-cheio { order: -1; height: 60vh; }
  }
</style>
